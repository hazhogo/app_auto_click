<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0E17"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TapLink"
        android:textColor="#00E5FF"
        android:textSize="38sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="48dp"
        android:text="Synchronized Auto Clicker"
        android:textColor="#8892B0"
        android:textSize="14sp" />

    <Button
        android:id="@+id/btnLocalMode"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="16dp"
        android:backgroundTint="#1F293D"
        android:text="وضع النقر الفردي (Local)"
        android:textColor="#FFFFFF" />

    <Button
        android:id="@+id/btnOnlineRoom"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:backgroundTint="#00E5FF"
        android:text="غرف المزامنة (Multiplayer)"
        android:textColor="#0A0E17"
        android:textStyle="bold" />
</LinearLayout>